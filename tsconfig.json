{
  // $app/tsconfig sets allowJs and checkJs. Full type coverage: every
  // component uses <script lang="ts"> and all of src/ and tests/ is .ts
  // (#306). checkJs catches any stray JS reintroduced later. CI runs
  // `pnpm run check`, so a regression fails the build.
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "sourceMap": true,
    "strict": true
  },
  "include": ["src", "tests", "vite.config.js", "playwright.config.js"]
}
